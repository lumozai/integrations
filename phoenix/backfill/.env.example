# Required — Lumoz API key (client_id:client_secret)
LUMOZ_API_KEY=client_id:client_secret

# Optional — only if your Phoenix server has authentication enabled
PHOENIX_API_KEY=

# Optional — override the defaults
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# OTEL_ENDPOINT=https://api.lumoz.ai/proxy/v1/traces
