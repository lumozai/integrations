# Required: the Anthropic API key the Claude Code CLI bills
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Lumoz tracing (without these two, the app runs and tracing is skipped)
LUMOZ_API_KEY=client_id:client_secret
OTEL_ENDPOINT=https://api.lumoz.ai/proxy/v1/traces

# Optional: deployment.environment on every span (default: development)
# LUMOZ_ENVIRONMENT=development

# Optional: an MCP server you started yourself; otherwise the runner starts mcp_server.py on port 8765
# HELPDESK_MCP_URL=http://127.0.0.1:8765/mcp

# Optional: run with the instrumentor alone, without the CLI's own telemetry
# CLAUDE_CODE_ENABLE_TELEMETRY=0
